{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npx http-server -p 4173 .",
      "startServerReadyPattern": "Available on:",
      "settings": {
        "chromeFlags": "--headless=new --disable-gpu --disable-dev-shm-usage --user-data-dir=.lighthouseci/chrome-profile"
      },
      "url": [
        "http://127.0.0.1:4173/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000 }]
      }
    }
  }
}
