{
  "name": "furniture-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:assets": "node scripts/check-assets.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:products": "node scripts/check-products.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test tests/e2e/checkout.spec.mjs",
    "quality": "npm run check:assets && npm run check:a11y && npm run check:products && npm run check:seo && npm run test:unit",
    "quality:release": "npm run quality && npm run check:lighthouse",
    "lighthouse": "node scripts/check-lighthouse.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.52.0",
    "http-server": "^14.1.1"
  }
}
